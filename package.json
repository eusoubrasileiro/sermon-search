{
  "name": "sermon-search",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Hybrid semantic + lexical search over a church's transcribed sermon archive",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "dev:shared": "pnpm --filter @ipp/shared dev",
    "dev:backend": "pnpm --filter @ipp/backend dev",
    "dev:frontend": "pnpm --filter @ipp/frontend dev",
    "dev": "pnpm --filter @ipp/shared build && concurrently -n backend,frontend -c blue,magenta \"pnpm dev:backend\" \"pnpm dev:frontend\"",
    "build": "pnpm --filter @ipp/shared build && pnpm --filter @ipp/backend build && pnpm --filter @ipp/frontend build",
    "test": "pnpm -r test",
    "test:coverage": "pnpm -r test:coverage",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "quality-gate": "node scripts/quality-gate.mjs",
    "quality-gate:update": "node scripts/quality-gate.mjs --update-baseline",
    "dispatch": "bash scripts/dispatch-worktree.sh",
    "dispatch:cleanup": "bash scripts/cleanup-worktrees.sh",
    "pr:create": "node scripts/pr-comment-review.mjs",
    "db:up": "docker compose up -d db",
    "db:push": "pnpm --filter @ipp/backend db:push",
    "index": "pnpm --filter @ipp/backend index",
    "verify:corpus": "pnpm --filter @ipp/backend verify:corpus",
    "derive:facets": "pnpm --filter @ipp/backend derive:facets",
    "extract:scripture": "pnpm --filter @ipp/backend extract:scripture",
    "label:topics": "pnpm --filter @ipp/backend label:topics",
    "canonicalize:series": "pnpm --filter @ipp/backend canonicalize:series",
    "index:facets": "pnpm --filter @ipp/backend index:facets",
    "check:spotify": "pnpm --filter @ipp/backend check:spotify",
    "verify:facets": "pnpm --filter @ipp/backend verify:facets",
    "corpus:update": "bash scripts/corpus-update.sh",
    "prepare": "husky",
    "eval": "pnpm --filter @ipp/backend eval",
    "compare:topics": "pnpm --filter @ipp/backend compare:topics"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.4",
    "@commitlint/cli": "^19.6.0",
    "@commitlint/config-conventional": "^19.6.0",
    "concurrently": "^9.1.0",
    "husky": "^9.1.7",
    "jscpd": "^4.0.5",
    "knip": "^5.39.0",
    "lint-staged": "^15.2.11",
    "typescript": "^5.7.2"
  }
}
